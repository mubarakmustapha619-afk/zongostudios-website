# Password required to access /admin. Pick a strong, unique value.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Read/write token for the Vercel Blob store used to persist site content and
# uploaded images. Automatically set by Vercel once you connect a Blob store
# to this project. For local development, run `vercel env pull .env.local`
# after connecting Blob, or copy the token from the Vercel dashboard
# (Storage -> your Blob store -> the ".env.local" tab).
BLOB_READ_WRITE_TOKEN=
